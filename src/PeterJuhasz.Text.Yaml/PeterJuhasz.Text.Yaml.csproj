<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>PeterJuhasz.Text.Yaml</RootNamespace>
	</PropertyGroup>

	<PropertyGroup>
		<VersionPrefix>1.1.0</VersionPrefix>
		<PackageId>PeterJuhasz.Text.Yaml</PackageId>
		<PackageTags>yaml</PackageTags>
		<PackageProjectUrl>https://github.com/Peter-Juhasz/yaml</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Peter-Juhasz/yaml</RepositoryUrl>
	</PropertyGroup>

	<PropertyGroup>
		<IsTrimmable>true</IsTrimmable>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<IsAotCompatible>true</IsAotCompatible>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration) == 'Release'">
		<TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="PeterJuhasz.Extensions" Version="2.*-*" />
	</ItemGroup>

	<!-- the source generator is shipped in the package, and runs in the projects referencing it -->
	<ItemGroup>
		<ProjectReference Include="..\PeterJuhasz.Text.Yaml.SourceGeneration\PeterJuhasz.Text.Yaml.SourceGeneration.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
		<None Include="..\PeterJuhasz.Text.Yaml.SourceGeneration\bin\$(Configuration)\netstandard2.0\PeterJuhasz.Text.Yaml.SourceGeneration.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>

</Project>
