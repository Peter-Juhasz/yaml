<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>PeterJuhasz.Text.Yaml</RootNamespace>
	</PropertyGroup>

	<PropertyGroup>
		<VersionPrefix>1.0.0</VersionPrefix>
		<PackageId>PeterJuhasz.Text.Yaml</PackageId>
		<PackageTags>yaml</PackageTags>
		<PackageProjectUrl>https://github.com/Peter-Juhasz/yaml</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Peter-Juhasz/yaml</RepositoryUrl>
	</PropertyGroup>

	<PropertyGroup>
		<IsTrimmable>true</IsTrimmable>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<IsAotCompatible>true</IsAotCompatible>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration) == 'Release'">
		<TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="PeterJuhasz.Extensions" Version="2.*-*" />
	</ItemGroup>

</Project>
