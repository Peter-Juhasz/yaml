<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>PeterJuhasz.Text.Yaml.Tests</RootNamespace>

		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.collector" Version="*" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="*" />
		<PackageReference Include="MSTest.TestAdapter" Version="*" />
		<PackageReference Include="MSTest.TestFramework" Version="*" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\PeterJuhasz.Text.Yaml\PeterJuhasz.Text.Yaml.csproj" />
		<ProjectReference Include="..\..\src\PeterJuhasz.Text.Yaml.SourceGeneration\PeterJuhasz.Text.Yaml.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<PropertyGroup>
		<!-- the tests list unsupported and misconfigured types on purpose, to compare the errors raised by both serializers -->
		<NoWarn>$(NoWarn);YAML1003;YAML1005</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
	</ItemGroup>

</Project>
